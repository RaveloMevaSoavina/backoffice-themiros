# Meme instance Supabase que le dashboard.
VITE_SUPABASE_URL=https://supabase.example.com
# Cle « anon » uniquement. Les ecrans du backoffice passent par les fonctions
# backoffice_* qui verifient elles-memes que le compte administre la
# plateforme. N'utilisez JAMAIS la cle service_role ici.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# API Themiros : envoi des invitations par e-mail (cle serveur cote API).
VITE_API_URL=http://127.0.0.1:8000
# Lien « ouvrir dans le dashboard » depuis la fiche d'un espace.
VITE_DASHBOARD_URL=http://localhost:5173
